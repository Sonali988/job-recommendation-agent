# YuvaMitra Backend (U2) environment configuration
# Copy to .env and adjust. NEVER commit real credentials.

# Amazon Bedrock (any Converse-API-compatible model works: Nova, Claude, Llama, ...)
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AWS_REGION=us-east-1

# CORS (frontend origin)
ALLOWED_ORIGIN=http://localhost:5173

# AI guardrails / resiliency
AI_TIMEOUT_S=20
AI_MAX_TOKENS=1024
AI_RATE_LIMIT_PER_MIN=30

# Health cache
HEALTH_CACHE_TTL_S=60

# Agent cycle thresholds
DEADLINE_WINDOW_DAYS=14
INACTIVITY_WINDOW_DAYS=7
PROGRESS_DELTA_THRESHOLD=5

# AWS credentials: put these in backend/.env (gitignored) OR use ~/.aws / an IAM role.
# The backend loads backend/.env into the environment at startup so boto3 can read them.
# AWS_ACCESS_KEY_ID=your-key-id
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_SESSION_TOKEN=            # only for temporary/STS credentials
